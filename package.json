{
  "name": "expire-food",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "test": "vp test",
    "knip": "knip",
    "lighthouse": "lhci autorun",
    "semgrep": "semgrep scan --config .semgrep/ --config p/typescript --config p/secrets --error",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply expire-food --local",
    "db:migrate:remote": "wrangler d1 migrations apply expire-food --remote",
    "deploy": "vp build && wrangler deploy",
    "prepare": "vp config"
  },
  "dependencies": {
    "hono": "4.13.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.58.0",
    "@lhci/cli": "0.15.1",
    "@vitest/coverage-v8": "5.0.1",
    "knip": "6.38.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vite-plus": "1.0.0-rc.0",
    "vitest": "5.0.1",
    "wrangler": "4.137.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
    "vitest": "5.0.1"
  },
  "packageManager": "bun@1.3.11"
}
