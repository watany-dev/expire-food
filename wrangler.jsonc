{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expire-food",
  "main": "./src/index.tsx",
  "compatibility_date": "2026-09-20",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "expire-food",
      // `wrangler d1 create expire-food` で発行された ID に置き換える（Phase 1）
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ai": {
    "binding": "AI",
    // ローカル開発でも Workers AI はリモート実行になる
    "remote": true,
  },
  "ratelimits": [
    {
      // /api/extract 用: space_id ごとに 1 分あたり 10 回
      "name": "EXTRACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
}
