{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "expire-food",
  "main": "./src/index.tsx",
  "compatibility_date": "2026-09-20",
  "observability": {
    "enabled": true,
    "logs": {
      // 呼び出しログはリクエスト URL を残し、共有 URL（/s/<space_id>）がそのまま載るので切る。console.* のログは残る
      "invocation_logs": false,
    },
  },
  // バンドルを minify するので、Workers Logs のスタックトレースを元のソースで読めるようにする
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "expire-food",
      // infra/ の Terraform が作った D1（`terraform -chdir=infra output -raw d1_database_id`）
      "database_id": "fd07c957-4891-428a-92b2-94cc57103a4a",
      "migrations_dir": "migrations",
    },
  ],
  "ai": {
    "binding": "AI",
    // ローカル開発でも Workers AI はリモート実行になる
    "remote": true,
  },
  "ratelimits": [
    {
      // /api/extract 用: space_id ごとに 1 分あたり 10 回
      "name": "EXTRACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      // スペースの発行用: 接続元（IPv6 は /64）ごとに 1 分あたり 5 回
      "name": "SPACE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    {
      // /api/extract 用: 接続元（IPv6 は /64）ごとに 1 分あたり 30 回。スペースを量産して枠を増やせないようにする。
      // 携帯回線の CGNAT などで同じ IP の後ろに他人がいるので、スペースごとの枠より緩くする
      "name": "EXTRACT_IP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
}
